#!/usr/bin/env ruby
# frozen_string_literal: true

require "exa-ai"
require_relative "../lib/exa/cli/search_parser"

def print_help
  puts <<~HELP
    Usage: exa-ai search QUERY [OPTIONS]

    Search the web using Exa AI

    Arguments:
      QUERY                 Search query (required)

    Options:
      --num-results N              Number of results to return (default: 10)
      --type TYPE                  Search type: auto, lite, deep-lite, deep, neural, fast,
                                   deep-reasoning, or instant (default: auto)
                                   fast and instant are legacy: use lite instead
                                   deep-reasoning is legacy: use deep instead
                                   neural is legacy: still accepted, not in the spec
                                   lite accepts a limited set of parameters
                                   deep/deep-lite/deep-reasoning synthesize an 'output' field
                                   only when --output-schema is provided
      --category CAT               Focus on specific data category
                                   Options: "company", "publication", "news",
                                   "personal site", "people", "financial report"
      --include-domains D          Comma-separated list of domains to include
      --exclude-domains D          Comma-separated list of domains to exclude
      --start-published-date DATE  Filter by published date (ISO 8601 format)
      --end-published-date DATE    Filter by published date (ISO 8601 format)
      --start-crawl-date DATE      Deprecated: the API ignores it and returns a warning
      --end-crawl-date DATE        Deprecated: the API ignores it and returns a warning
      --include-text PHRASE        Deprecated: include results that contain the phrase
                                   (approximate match, repeatable)
      --exclude-text PHRASE        Deprecated: exclude results that contain the phrase
                                   (approximate match, repeatable)

    Content Extraction:
    #{Exa::CLI::ContentsFlags::HELP}

    Search Options:
      --additional-queries QUERY   Additional search queries (repeatable)
      --output-schema JSON         JSON schema for output structure (@file syntax)
                                   Required to get synthesized 'output' from deep/deep-reasoning
      --user-location LOC          User location: ISO country code (US), or a JSON
                                   object with country, latitude, longitude
                                   (@file syntax)
      --objective TEXT             The broader goal this search serves
      --user-identifier ID         Your identifier for the end user
      --compliance MODE            Compliance mode: hipaa (enterprise only)
      --system-prompt PROMPT       System prompt for AI-powered search
      --moderation                 Enable content moderation

    General Options:
      --api-key KEY                Exa API key (or set EXA_API_KEY env var)
      --output-format FMT          Output format: json, pretty, or text (default: json)
      --print-request              Write the JSON request body sent to the API to stderr
                                   (one line); the request is still sent
      --flags-json                 Print every flag this command accepts as JSON and exit
      --help, -h                   Show this help message

    Examples:
      exa-ai search "ruby programming"
      exa-ai search "machine learning" --num-results 5 --type deep
      exa-ai search "Latest LLM research" --category publication
      exa-ai search "AI startups" --category company
      exa-ai search "Dario Amodei" --category people
      exa-ai search "AI research" --include-domains arxiv.org,scholar.google.com
      exa-ai search "tutorials" --output-format pretty
  HELP
end

# Main execution
begin
  # Print the flag list for wrappers before anything else, so it needs no
  # API key and wins over a query, --help and unknown flags.
  if ARGV.include?("--flags-json")
    puts JSON.generate(Exa::CLI::SearchParser::FLAGS)
    exit 0
  end

  # Handle help flag
  if ARGV.include?("--help") || ARGV.include?("-h")
    print_help
    exit 0
  end

  # Parse command-line arguments
  args = Exa::CLI::SearchParser.parse(ARGV)

  # Resolve API key
  api_key = Exa::CLI::Base.resolve_api_key(args[:api_key])

  # Resolve output format
  output_format = Exa::CLI::Base.resolve_output_format(args[:output_format])

  # Build client
  client = Exa::CLI::Base.build_client(api_key, print_request: args[:print_request])

  # Prepare search parameters
  search_params = {}
  search_params[:num_results] = args[:num_results] if args[:num_results]
  search_params[:type] = args[:type] if args[:type]
  search_params[:category] = args[:category] if args[:category]
  search_params[:include_domains] = args[:include_domains] if args[:include_domains]
  search_params[:exclude_domains] = args[:exclude_domains] if args[:exclude_domains]
  search_params[:start_published_date] = args[:start_published_date] if args[:start_published_date]
  search_params[:end_published_date] = args[:end_published_date] if args[:end_published_date]
  search_params[:start_crawl_date] = args[:start_crawl_date] if args[:start_crawl_date]
  search_params[:end_crawl_date] = args[:end_crawl_date] if args[:end_crawl_date]
  search_params[:include_text] = args[:include_text] if args[:include_text]
  search_params[:exclude_text] = args[:exclude_text] if args[:exclude_text]
  search_params[:additional_queries] = args[:additional_queries] if args[:additional_queries]
  search_params[:output_schema] = args[:output_schema] if args[:output_schema]
  search_params[:user_location] = args[:user_location] if args[:user_location]
  search_params[:system_prompt] = args[:system_prompt] if args[:system_prompt]
  search_params[:moderation] = args[:moderation] if args[:moderation]
  search_params[:objective] = args[:objective] if args[:objective]
  search_params[:user_identifier] = args[:user_identifier] if args[:user_identifier]
  search_params[:compliance] = args[:compliance] if args[:compliance]
  search_params[:snapshot_as_of] = args[:snapshot_as_of] if args[:snapshot_as_of]
  contents = Exa::CLI::ContentsFlags.build(args)
  search_params.merge!(contents) if contents

  # Execute search
  result = client.search(args[:query], **search_params)

  # Format and output result
  output = Exa::CLI::Formatters::SearchFormatter.format(result, output_format)
  puts output
  $stdout.flush
  Exa::CLI::Formatters::SearchFormatter.print_warnings(result)

rescue Exa::ConfigurationError => e
  $stderr.puts "Configuration error: #{e.message}"
  exit 1
rescue Exa::Unauthorized => e
  $stderr.puts "Authentication error: #{e.message}"
  $stderr.puts "Check your API key (set EXA_API_KEY or use --api-key)"
  exit 1
rescue Exa::ClientError => e
  $stderr.puts "Client error: #{e.message}"
  exit 1
rescue Exa::ServerError => e
  $stderr.puts "Server error: #{e.message}"
  $stderr.puts "The Exa API may be experiencing issues. Please try again later."
  exit 1
rescue Exa::Error => e
  $stderr.puts "Error: #{e.message}"
  exit 1
rescue StandardError => e
  $stderr.puts "Unexpected error: #{e.message}"
  $stderr.puts e.backtrace.first(5) if ENV["DEBUG"]
  exit 1
end
