#!/usr/bin/env ruby
# frozen_string_literal: true

require "exa-ai"

# The line that tells the user how to get the next page, or nil when there
# are no more events.
def next_page_hint(events)
  return nil unless events.has_more && events.next_cursor

  "More events available. Use --cursor #{events.next_cursor} for the next page."
end

# Parse command-line arguments
api_key = nil
run_id = nil
output_format = "json"
list_params = {}

args = ARGV.dup
while args.any?
  arg = args.shift
  case arg
  when "--api-key"
    api_key = Exa::CLI::Base.text_value("--api-key", args.shift)
  when "--output-format"
    output_format = Exa::CLI::Base.text_value("--output-format", args.shift)
  when "--limit"
    list_params[:limit] = Exa::CLI::Base.parse_integer("--limit", args.shift)
  when "--cursor"
    list_params[:cursor] = Exa::CLI::Base.text_value("--cursor", args.shift)
  when "--help", "-h"
    puts <<~HELP
      Usage: exa-ai agent-run-events <run_id> [options]

      Retrieve events for an agent run.

      Arguments:
        run_id                  ID of the agent run

      Options:
        --api-key KEY           Exa API key (or use EXA_API_KEY env var)
        --limit N               Maximum number of events to return
        --cursor CURSOR         Cursor from a previous page, to get the next page
        --output-format FORMAT  Output format: json, pretty, or text (default: json)
        --help, -h              Show this help message

      Examples:
        exa-ai agent-run-events run_123
        exa-ai agent-run-events run_123 --output-format pretty
        exa-ai agent-run-events run_123 --limit 50 --cursor CURSOR
    HELP
    exit 0
  else
    # First positional argument is the run_id
    if run_id.nil?
      run_id = arg
    else
      $stderr.puts "Unknown option: #{arg}"
      exit 1
    end
  end
end

# Validate required arguments
if run_id.nil?
  $stderr.puts "Error: Run ID argument required"
  $stderr.puts "Usage: exa-ai agent-run-events <run_id> [options]"
  $stderr.puts "Try 'exa-ai agent-run-events --help' for more information"
  exit 1
end

begin
  # Resolve API key
  api_key = Exa::CLI::Base.resolve_api_key(api_key)

  # Build client
  client = Exa::CLI::Base.build_client(api_key)

  # Call API
  events = client.agent_run_events(run_id, **list_params)

  # Format output
  items = events.respond_to?(:data) ? events.data : events
  case output_format
  when "json"
    puts JSON.pretty_generate(events.respond_to?(:to_h) ? events.to_h : events)
  when "pretty"
    puts "Events for Agent Run: #{run_id}"
    puts ""
    items.each_with_index do |event, i|
      puts "#{i + 1}. #{event.respond_to?(:to_h) ? event.to_h.inspect : event}"
    end
    hint = next_page_hint(events)
    puts "", hint if hint
  when "text"
    items.each do |event|
      puts event.respond_to?(:to_h) ? event.to_h.inspect : event.to_s
    end
    hint = next_page_hint(events)
    puts hint if hint
  else
    puts JSON.pretty_generate(events.respond_to?(:to_h) ? events.to_h : events)
  end

rescue Exa::NotFound => e
  $stderr.puts "Agent run not found: #{e.message}"
  exit 1
rescue Exa::Unauthorized => e
  $stderr.puts "Authentication failed: #{e.message}"
  $stderr.puts "Please provide a valid API key via --api-key or EXA_API_KEY environment variable"
  exit 1
rescue Exa::ClientError => e
  $stderr.puts "Client error: #{e.message}"
  exit 1
rescue Exa::ServerError => e
  $stderr.puts "Server error: #{e.message}"
  exit 1
rescue Exa::Error => e
  $stderr.puts "Error: #{e.message}"
  exit 1
rescue StandardError => e
  $stderr.puts "Unexpected error: #{e.message}"
  exit 1
end
