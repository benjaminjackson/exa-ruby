#!/usr/bin/env ruby
# frozen_string_literal: true

require "exa-ai"

api_key = nil
output_format = "json"
search = {}
webhook = {}
params = {}

args = ARGV.dup
while args.any?
  arg = args.shift
  case arg
  when "--api-key"
    api_key = Exa::CLI::Base.text_value("--api-key", args.shift)
  when "--query"
    search[:query] = Exa::CLI::Base.text_value("--query", args.shift)
  when "--num-results"
    search[:num_results] = Exa::CLI::Base.parse_integer("--num-results", args.shift)
  when "--include-domains"
    search[:include_domains] = Exa::CLI::Base.text_value("--include-domains", args.shift).split(",").map(&:strip)
  when "--exclude-domains"
    search[:exclude_domains] = Exa::CLI::Base.text_value("--exclude-domains", args.shift).split(",").map(&:strip)
  when "--webhook-url"
    webhook[:url] = Exa::CLI::Base.text_value("--webhook-url", args.shift)
  when "--webhook-events"
    webhook[:events] = Exa::CLI::Base.text_value("--webhook-events", args.shift).split(",").map(&:strip)
  when "--period"
    params[:trigger] = { type: "interval", period: Exa::CLI::Base.text_value("--period", args.shift) }
  when "--name"
    params[:name] = Exa::CLI::Base.text_value("--name", args.shift)
  when "--output-schema"
    params[:output_schema] = Exa::CLI::Base.parse_json_or_file("--output-schema", args.shift)
  when "--metadata"
    params[:metadata] = Exa::CLI::Base.parse_json_or_file("--metadata", args.shift)
  when "--output-format"
    output_format = Exa::CLI::Base.text_value("--output-format", args.shift)
  when "--help", "-h"
    puts <<~HELP
      Usage: exa-ai search-monitor-create --query TEXT --webhook-url URL [options]

      Create a search monitor: a scheduled Exa search that posts new results to a webhook.
      Search monitors are the /monitors API.

      Required:
        --query TEXT            Search query
        --webhook-url URL       Webhook that receives results

      Options:
        --period PERIOD         Run on a schedule, e.g. 1h, 6h, 1d, 7d (minimum 1h).
                                Without it the monitor runs only with search-monitor-trigger.
        --name NAME             Monitor name
        --num-results N         Results per run
        --include-domains LIST  Comma-separated domains to include
        --exclude-domains LIST  Comma-separated domains to exclude
        --webhook-events LIST   Comma-separated webhook events
        --output-schema JSON    JSON schema for structured output (JSON or @file.json)
        --metadata JSON         Custom metadata (JSON or @file.json)
        --api-key KEY           Exa API key (or use EXA_API_KEY env var)
        --output-format FORMAT  Output format: json, pretty, text, or toon (default: json)
        --help, -h              Show this help message

      The response holds the webhook secret. The API returns it only once.

      Example:
        exa-ai search-monitor-create --query "AI/ML infrastructure startups with Series A funding" \\
          --webhook-url https://example.com/webhooks/exa --period 1d --name "AI funding"
    HELP
    exit 0
  else
    $stderr.puts "Unknown option: #{arg}"
    exit 1
  end
end

unless search[:query] && webhook[:url]
  $stderr.puts "Error: --query and --webhook-url are required. Run with --help for usage."
  exit 1
end

begin
  output_format = Exa::CLI::Base.resolve_output_format(output_format)
  client = Exa::CLI::Base.build_client(Exa::CLI::Base.resolve_api_key(api_key))
  result = client.search_monitor_create(search: search, webhook: webhook, **params)
  puts Exa::CLI::Formatters::SearchMonitorFormatter.format(result, output_format)
rescue Exa::Unauthorized => e
  $stderr.puts "Authentication failed: #{e.message}"
  $stderr.puts "Please provide a valid API key via --api-key or EXA_API_KEY environment variable"
  exit 1
rescue Exa::ClientError => e
  $stderr.puts "Client error: #{e.message}"
  exit 1
rescue Exa::ServerError => e
  $stderr.puts "Server error: #{e.message}"
  exit 1
rescue Exa::Error => e
  $stderr.puts "Error: #{e.message}"
  exit 1
rescue StandardError => e
  $stderr.puts "Unexpected error: #{e.message}"
  exit 1
end
