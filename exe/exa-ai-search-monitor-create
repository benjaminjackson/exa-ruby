#!/usr/bin/env ruby
# frozen_string_literal: true

require "exa-ai"

# Parse a JSON string, or read JSON from a file when the value starts with @.
def parse_json_or_file(value)
  text = value.start_with?("@") ? File.read(value[1..]) : value
  JSON.parse(text)
rescue JSON::ParserError => e
  warn "Error: Invalid JSON: #{e.message}"
  exit 1
rescue Errno::ENOENT => e
  warn "Error: File not found: #{e.message}"
  exit 1
end

api_key = nil
output_format = "json"
search = {}
webhook = {}
params = {}

args = ARGV.dup
while args.any?
  arg = args.shift
  case arg
  when "--api-key"
    api_key = args.shift
  when "--query"
    search[:query] = args.shift
  when "--num-results"
    search[:num_results] = args.shift.to_i
  when "--include-domains"
    search[:include_domains] = args.shift.split(",").map(&:strip)
  when "--exclude-domains"
    search[:exclude_domains] = args.shift.split(",").map(&:strip)
  when "--webhook-url"
    webhook[:url] = args.shift
  when "--webhook-events"
    webhook[:events] = args.shift.split(",").map(&:strip)
  when "--period"
    params[:trigger] = { type: "interval", period: args.shift }
  when "--name"
    params[:name] = args.shift
  when "--output-schema"
    params[:output_schema] = parse_json_or_file(args.shift)
  when "--metadata"
    params[:metadata] = parse_json_or_file(args.shift)
  when "--output-format"
    output_format = args.shift
  when "--help", "-h"
    puts <<~HELP
      Usage: exa-ai search-monitor-create --query TEXT --webhook-url URL [options]

      Create a search monitor: a scheduled Exa search that posts new results to a webhook.
      Search monitors are the /monitors API, not Websets monitors (exa-ai monitor-*).

      Required:
        --query TEXT            Search query
        --webhook-url URL       Webhook that receives results

      Options:
        --period PERIOD         Run on a schedule, e.g. 1h, 6h, 1d, 7d (minimum 1h).
                                Without it the monitor runs only with search-monitor-trigger.
        --name NAME             Monitor name
        --num-results N         Results per run
        --include-domains LIST  Comma-separated domains to include
        --exclude-domains LIST  Comma-separated domains to exclude
        --webhook-events LIST   Comma-separated webhook events
        --output-schema JSON    JSON schema for structured output (JSON or @file.json)
        --metadata JSON         Custom metadata (JSON or @file.json)
        --api-key KEY           Exa API key (or use EXA_API_KEY env var)
        --output-format FORMAT  Output format: json, pretty, text, or toon (default: json)
        --help, -h              Show this help message

      The response holds the webhook secret. The API returns it only once.

      Example:
        exa-ai search-monitor-create --query "AI/ML infrastructure startups with Series A funding" \\
          --webhook-url https://example.com/webhooks/exa --period 1d --name "AI funding"
    HELP
    exit 0
  else
    warn "Unknown option: #{arg}"
    exit 1
  end
end

unless search[:query] && webhook[:url]
  warn "Error: --query and --webhook-url are required. Run with --help for usage."
  exit 1
end

begin
  client = Exa::CLI::Base.build_client(Exa::CLI::Base.resolve_api_key(api_key))
  result = client.search_monitor_create(search: search, webhook: webhook, **params)
  puts Exa::CLI::Formatters::SearchMonitorFormatter.format(result, output_format)
rescue Exa::Unauthorized => e
  warn "Authentication failed: #{e.message}"
  warn "Please provide a valid API key via --api-key or EXA_API_KEY environment variable"
  exit 1
rescue Exa::ClientError => e
  warn "Client error: #{e.message}"
  exit 1
rescue Exa::ServerError => e
  warn "Server error: #{e.message}"
  exit 1
rescue Exa::Error => e
  warn "Error: #{e.message}"
  exit 1
rescue StandardError => e
  warn "Unexpected error: #{e.message}"
  exit 1
end
