#!/usr/bin/env ruby
# frozen_string_literal: true

require "exa-ai"

api_key = nil
output_format = "json"
action = nil
filter = {}
limit = nil
dry_run = true

args = ARGV.dup
while args.any?
  arg = args.shift
  case arg
  when "--api-key"
    api_key = Exa::CLI::Base.text_value("--api-key", args.shift)
  when "--action"
    action = Exa::CLI::Base.text_value("--action", args.shift)
  when "--status"
    filter[:status] = Exa::CLI::Base.text_value("--status", args.shift)
  when "--name"
    filter[:name] = Exa::CLI::Base.text_value("--name", args.shift)
  when "--metadata"
    filter[:metadata] = Exa::CLI::Base.parse_json_or_file("--metadata", args.shift)
  when "--limit"
    limit = Exa::CLI::Base.parse_integer("--limit", args.shift)
  when "--execute"
    dry_run = false
  when "--output-format"
    output_format = Exa::CLI::Base.text_value("--output-format", args.shift)
  when "--help", "-h"
    puts <<~HELP
      Usage: exa-ai search-monitor-batch --action ACTION [filter options] [options]

      Delete, pause, or unpause every search monitor that matches a filter.
      This is a DRY RUN by default: it only reports what would change.
      Pass --execute to apply the change. Repeat until has_more is false.

      Required:
        --action ACTION         delete, pause, or unpause

      Filter options:
        --status STATUS         Match monitors with this status
        --name TEXT             Match monitors whose name contains TEXT
        --metadata JSON         Match metadata key-value pairs (JSON or @file.json)

      Options:
        --limit N               Maximum monitors to change in one call
        --execute               Apply the change (default: dry run)
        --api-key KEY           Exa API key (or use EXA_API_KEY env var)
        --output-format FORMAT  Output format: json, pretty, text, or toon (default: json)
        --help, -h              Show this help message

      Examples:
        exa-ai search-monitor-batch --action pause --status active
        exa-ai search-monitor-batch --action delete --name "old test" --execute
    HELP
    exit 0
  else
    $stderr.puts "Unknown option: #{arg}"
    exit 1
  end
end

unless %w[delete pause unpause].include?(action)
  $stderr.puts "Error: --action must be delete, pause, or unpause. Run with --help for usage."
  exit 1
end

begin
  output_format = Exa::CLI::Base.resolve_output_format(output_format)
  client = Exa::CLI::Base.build_client(Exa::CLI::Base.resolve_api_key(api_key))
  result = client.search_monitor_batch(action: action, filter: filter, dry_run: dry_run, limit: limit)
  puts Exa::CLI::Formatters::SearchMonitorFormatter.format(result, output_format)
rescue Exa::Unauthorized => e
  $stderr.puts "Authentication failed: #{e.message}"
  $stderr.puts "Please provide a valid API key via --api-key or EXA_API_KEY environment variable"
  exit 1
rescue Exa::ClientError => e
  $stderr.puts "Client error: #{e.message}"
  exit 1
rescue Exa::ServerError => e
  $stderr.puts "Server error: #{e.message}"
  exit 1
rescue Exa::Error => e
  $stderr.puts "Error: #{e.message}"
  exit 1
rescue StandardError => e
  $stderr.puts "Unexpected error: #{e.message}"
  exit 1
end
