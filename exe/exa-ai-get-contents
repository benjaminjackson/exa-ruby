#!/usr/bin/env ruby
# frozen_string_literal: true

require "exa-ai"
require_relative "../lib/exa/cli/search_parser"

VALID_HIGHLIGHTS_VERBOSITY = %w[low medium high].freeze

# Raises ArgumentError unless value is one of the allowed values for flag.
def validate_choice(flag, value, allowed)
  return if allowed.include?(value)

  raise ArgumentError, "#{flag} must be one of: #{allowed.join(', ')}"
end

# Parse command line arguments
def parse_args(args)
  urls = []
  ids = []
  max_age_hours = nil
  snapshot_as_of = nil
  user_identifier = nil
  compliance = nil
  highlights = false
  highlights_query = nil
  highlights_max_characters = nil
  highlights_verbosity = nil
  text_verbosity = nil
  api_key = nil
  text = false
  text_max_characters = nil
  include_html_tags = false
  summary = false
  summary_query = nil
  summary_schema = nil
  subpages = nil
  subpage_target = []
  links = nil
  image_links = nil
  context = false
  context_max_characters = nil
  livecrawl_timeout = nil
  output_format = nil
  print_request = false

  i = 0
  while i < args.length
    arg = args[i]

    case arg
    when "--api-key"
      api_key = args[i + 1]
      i += 2
    when "--text"
      text = true
      i += 1
    when "--text-max-characters"
      text_max_characters = Exa::CLI::Base.parse_integer("--text-max-characters", args[i + 1])
      i += 2
    when "--include-html-tags"
      include_html_tags = true
      i += 1
    when "--summary"
      summary = true
      i += 1
    when "--summary-query"
      summary_query = args[i + 1]
      i += 2
    when "--summary-schema"
      summary_schema = Exa::CLI::Base.parse_json_or_file("--summary-schema", args[i + 1])
      i += 2
    when "--subpages"
      subpages = Exa::CLI::Base.parse_integer("--subpages", args[i + 1])
      i += 2
    when "--subpage-target"
      subpage_target << args[i + 1]
      i += 2
    when "--links"
      links = Exa::CLI::Base.parse_integer("--links", args[i + 1])
      i += 2
    when "--image-links"
      image_links = Exa::CLI::Base.parse_integer("--image-links", args[i + 1])
      i += 2
    when "--context"
      context = true
      i += 1
    when "--context-max-characters"
      context_max_characters = Exa::CLI::Base.parse_integer("--context-max-characters", args[i + 1])
      i += 2
    when "--livecrawl-timeout"
      livecrawl_timeout = Exa::CLI::Base.parse_integer("--livecrawl-timeout", args[i + 1])
      i += 2
    when "--output-format"
      output_format = args[i + 1]
      i += 2
    when "--ids"
      ids = Exa::CLI::Base.option_value("--ids", args[i + 1]).split(",").map(&:strip)
      i += 2
    when "--max-age-hours"
      max_age_hours = Exa::CLI::Base.parse_integer("--max-age-hours", args[i + 1])
      i += 2
    when "--snapshot-as-of"
      snapshot_as_of = args[i + 1]
      i += 2
    when "--user-identifier"
      user_identifier = args[i + 1]
      i += 2
    when "--compliance"
      compliance = args[i + 1]
      validate_choice("--compliance", compliance, Exa::CLI::SearchParser::VALID_COMPLIANCE)
      i += 2
    when "--highlights"
      highlights = true
      i += 1
    when "--highlights-query"
      highlights_query = args[i + 1]
      i += 2
    when "--highlights-max-characters"
      highlights_max_characters = Exa::CLI::Base.parse_integer("--highlights-max-characters", args[i + 1])
      i += 2
    when "--highlights-verbosity"
      highlights_verbosity = args[i + 1]
      validate_choice("--highlights-verbosity", highlights_verbosity, VALID_HIGHLIGHTS_VERBOSITY)
      i += 2
    when "--text-verbosity"
      text_verbosity = args[i + 1]
      validate_choice("--text-verbosity", text_verbosity, Exa::CLI::SearchParser::VALID_TEXT_VERBOSITY)
      i += 2
    when "--print-request"
      print_request = true
      i += 1
    when "--help", "-h"
      print_help
      exit 0
    else
      # First non-flag argument is the URLs (comma-separated or single)
      urls = arg.split(",").map(&:strip) if urls.empty?
      i += 1
    end
  end

  {
    urls: urls,
    ids: ids,
    max_age_hours: max_age_hours,
    snapshot_as_of: snapshot_as_of,
    user_identifier: user_identifier,
    compliance: compliance,
    highlights: highlights,
    highlights_query: highlights_query,
    highlights_max_characters: highlights_max_characters,
    highlights_verbosity: highlights_verbosity,
    text_verbosity: text_verbosity,
    api_key: api_key,
    text: text,
    text_max_characters: text_max_characters,
    include_html_tags: include_html_tags,
    summary: summary,
    summary_query: summary_query,
    summary_schema: summary_schema,
    subpages: subpages,
    subpage_target: subpage_target,
    links: links,
    image_links: image_links,
    context: context,
    context_max_characters: context_max_characters,
    livecrawl_timeout: livecrawl_timeout,
    output_format: output_format,
    print_request: print_request
  }
end

# Build contents parameters from extracted flags
def build_contents_params(args)
  params = {}

  # Text options
  if args[:text]
    if args[:text_max_characters] || args[:include_html_tags] || args[:text_verbosity]
      params[:text] = {}
      params[:text][:max_characters] = args[:text_max_characters] if args[:text_max_characters]
      params[:text][:include_html_tags] = args[:include_html_tags] if args[:include_html_tags]
      params[:text][:verbosity] = args[:text_verbosity] if args[:text_verbosity]
    else
      params[:text] = true
    end
  end

  # Summary options
  if args[:summary]
    if args[:summary_query] || args[:summary_schema]
      params[:summary] = {}
      params[:summary][:query] = args[:summary_query] if args[:summary_query]
      params[:summary][:schema] = args[:summary_schema] if args[:summary_schema]
    else
      params[:summary] = true
    end
  end

  # Context options
  if args[:context]
    if args[:context_max_characters]
      params[:context] = { max_characters: args[:context_max_characters] }
    else
      params[:context] = true
    end
  end

  # Subpages options
  params[:subpages] = args[:subpages] if args[:subpages]
  params[:subpage_target] = args[:subpage_target] if args[:subpage_target].any?

  # Extras options
  if args[:links] || args[:image_links]
    params[:extras] = {}
    params[:extras][:links] = args[:links] if args[:links]
    params[:extras][:image_links] = args[:image_links] if args[:image_links]
  end

  # Highlights options
  if args[:highlights]
    if args[:highlights_query] || args[:highlights_max_characters] || args[:highlights_verbosity]
      params[:highlights] = {}
      params[:highlights][:query] = args[:highlights_query] if args[:highlights_query]
      params[:highlights][:max_characters] = args[:highlights_max_characters] if args[:highlights_max_characters]
      params[:highlights][:verbosity] = args[:highlights_verbosity] if args[:highlights_verbosity]
    else
      params[:highlights] = true
    end
  end

  # Livecrawl and freshness options
  params[:livecrawl_timeout] = args[:livecrawl_timeout] if args[:livecrawl_timeout]
  params[:max_age_hours] = args[:max_age_hours] if args[:max_age_hours]
  params[:snapshot_as_of] = args[:snapshot_as_of] if args[:snapshot_as_of]

  # Request options
  params[:ids] = args[:ids] if args[:ids].any?
  params[:user_identifier] = args[:user_identifier] if args[:user_identifier]
  params[:compliance] = args[:compliance] if args[:compliance]

  params.empty? ? nil : params
end

def print_help
  puts <<~HELP
    Usage: exa-ai get-contents <urls> [options]
           exa-ai get-contents --ids ID1,ID2 [options]

    Retrieve full page contents from URLs or document IDs

    Arguments:
      urls                   Comma-separated list of URLs (required unless --ids is given)

    Options:
      Text Extraction:
        --text                       Include page text in response
        --text-max-characters N      Max characters for page text
        --include-html-tags          Include HTML tags in text extraction
        --text-verbosity LEVEL       Text verbosity: compact, standard, or full

      Summary:
        --summary                    Include AI-generated summary
        --summary-query PROMPT       Custom prompt for summary generation
        --summary-schema FILE        JSON schema for summary structure (@file syntax)

      Context:
        --context                    Deprecated: use --highlights or --text instead
                                     (format results as one context string)
        --context-max-characters N   Deprecated: max characters for context string

      Subpages:
        --subpages N                 Number of subpages to crawl
        --subpage-target PHRASE      Subpage target phrases (repeatable)

      Extras:
        --links N                    Number of links to extract per result
        --image-links N              Number of image links to extract

      Highlights:
        --highlights                 Include text highlights in results
        --highlights-query QUERY     Custom query for highlight extraction
        --highlights-max-characters N  Max characters per highlight
        --highlights-verbosity LEVEL Highlights verbosity: low, medium, or high
                                     (sends the Exa-Beta dynamic highlights header)

      Livecrawl and Freshness:
        --livecrawl-timeout N        Timeout for livecrawling in milliseconds
        --max-age-hours N            Maximum age of cached content in hours
        --snapshot-as-of DATE        Return page contents as of this time (ISO 8601)

      Request:
        --ids ID1,ID2                Comma-separated document IDs from earlier searches
        --user-identifier ID         Your identifier for the end user
        --compliance MODE            Compliance mode: hipaa (enterprise only)

      General:
        --api-key KEY                Exa API key (or set EXA_API_KEY env var)
        --output-format FMT          Output format: json, pretty, or text (default: json)
        --print-request              Write the JSON request body sent to the API to stderr
                                     (one line); the request is still sent
        --help, -h                   Show this help message

    Examples:
      exa-ai get-contents 'https://example.com'
      exa-ai get-contents 'https://example.com' --text
      exa-ai get-contents 'https://example.com' --text --text-max-characters 3000 --include-html-tags
      exa-ai get-contents 'url1,url2' --summary --summary-query "Be terse"
      exa-ai get-contents 'https://example.com' --subpages 1 --subpage-target about
      exa-ai get-contents 'https://example.com' --links 5 --image-links 10
  HELP
end

begin
  # Parse arguments
  options = parse_args(ARGV)

  # Validate that there is something to fetch
  if options[:urls].empty? && options[:ids].empty?
    $stderr.puts "Error: URLs argument or --ids required"
    $stderr.puts ""
    $stderr.puts "Run 'exa-ai get-contents --help' for usage information."
    exit 1
  end

  # Resolve API key
  api_key = Exa::CLI::Base.resolve_api_key(options[:api_key])

  # Resolve output format
  output_format = Exa::CLI::Base.resolve_output_format(options[:output_format])

  # Build client
  client = Exa::CLI::Base.build_client(api_key)

  # Build request parameters
  params = build_contents_params(options)
  params ||= {}
  params[:on_request] = Exa::CLI::Base.request_printer if options[:print_request]

  # Call API
  urls = options[:urls].empty? ? nil : options[:urls]
  result = client.get_contents(urls, **params)

  # Format and output
  output = Exa::CLI::Formatters::ContentsFormatter.format(result, output_format)
  puts output
  $stdout.flush
rescue ArgumentError => e
  $stderr.puts "Error: #{e.message}"
  exit 1
rescue Exa::ConfigurationError => e
  $stderr.puts "Configuration error: #{e.message}"
  exit 1
rescue Exa::Unauthorized => e
  $stderr.puts "Authentication error: #{e.message}"
  $stderr.puts "Check your API key (set EXA_API_KEY or use --api-key)"
  exit 1
rescue Exa::ClientError => e
  $stderr.puts "Client error: #{e.message}"
  exit 1
rescue Exa::ServerError => e
  $stderr.puts "Server error: #{e.message}"
  $stderr.puts "The Exa API may be experiencing issues. Please try again later."
  exit 1
rescue Exa::Error => e
  $stderr.puts "Error: #{e.message}"
  exit 1
rescue StandardError => e
  $stderr.puts "Unexpected error: #{e.message}"
  $stderr.puts e.backtrace.first(5) if ENV["DEBUG"]
  exit 1
end
