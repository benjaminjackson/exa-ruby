#!/usr/bin/env ruby
# frozen_string_literal: true

require "exa-ai"

# Global CLI interface for Exa API

module ExaCLI
  AVAILABLE_COMMANDS = {
    "search" => "Search the web",
    "find-similar" => "Find content similar to a URL",
    "answer" => "Generate an answer to a question",
    "context" => "Get code context from repositories",
    "get-contents" => "Retrieve page contents",
    "search-monitor-create" => "Create a search monitor",
    "search-monitor-get" => "Get search monitor details",
    "search-monitor-list" => "List search monitors",
    "search-monitor-update" => "Update a search monitor",
    "search-monitor-delete" => "Delete a search monitor",
    "search-monitor-trigger" => "Run a search monitor now",
    "search-monitor-batch" => "Delete, pause or unpause search monitors in bulk",
    "search-monitor-runs-list" => "List search monitor runs",
    "search-monitor-runs-get" => "Get search monitor run details",
    "agent-run-create" => "Create an agent run",
    "agent-run-get" => "Get agent run details",
    "agent-run-list" => "List agent runs",
    "agent-run-cancel" => "Cancel an agent run",
    "agent-run-stop" => "Stop an agent run early and keep its results",
    "agent-run-delete" => "Delete an agent run",
    "agent-run-events" => "Get events for an agent run"
  }.freeze

  def self.run
    case ARGV[0]
    when "--version"
      puts Exa::VERSION
      exit 0
    when "--help", "help", "-h", nil
      print_help
      exit 0
    when "--api-key"
      $stderr.puts "Error: Use --api-key flag with specific commands"
      exit 1
    when "search"
      exec File.expand_path("../exa-ai-search", __FILE__), *ARGV[1..]
    when "find-similar"
      exec File.expand_path("../exa-ai-find-similar", __FILE__), *ARGV[1..]
    when "answer"
      exec File.expand_path("../exa-ai-answer", __FILE__), *ARGV[1..]
    when "context"
      exec File.expand_path("../exa-ai-context", __FILE__), *ARGV[1..]
    when "get-contents"
      exec File.expand_path("../exa-ai-get-contents", __FILE__), *ARGV[1..]
    when "search-monitor-create"
      exec File.expand_path("../exa-ai-search-monitor-create", __FILE__), *ARGV[1..]
    when "search-monitor-get"
      exec File.expand_path("../exa-ai-search-monitor-get", __FILE__), *ARGV[1..]
    when "search-monitor-list"
      exec File.expand_path("../exa-ai-search-monitor-list", __FILE__), *ARGV[1..]
    when "search-monitor-update"
      exec File.expand_path("../exa-ai-search-monitor-update", __FILE__), *ARGV[1..]
    when "search-monitor-delete"
      exec File.expand_path("../exa-ai-search-monitor-delete", __FILE__), *ARGV[1..]
    when "search-monitor-trigger"
      exec File.expand_path("../exa-ai-search-monitor-trigger", __FILE__), *ARGV[1..]
    when "search-monitor-batch"
      exec File.expand_path("../exa-ai-search-monitor-batch", __FILE__), *ARGV[1..]
    when "search-monitor-runs-list"
      exec File.expand_path("../exa-ai-search-monitor-runs-list", __FILE__), *ARGV[1..]
    when "search-monitor-runs-get"
      exec File.expand_path("../exa-ai-search-monitor-runs-get", __FILE__), *ARGV[1..]
    when "agent-run-create"
      exec File.expand_path("../exa-ai-agent-run-create", __FILE__), *ARGV[1..]
    when "agent-run-get"
      exec File.expand_path("../exa-ai-agent-run-get", __FILE__), *ARGV[1..]
    when "agent-run-list"
      exec File.expand_path("../exa-ai-agent-run-list", __FILE__), *ARGV[1..]
    when "agent-run-cancel"
      exec File.expand_path("../exa-ai-agent-run-cancel", __FILE__), *ARGV[1..]
    when "agent-run-stop"
      exec File.expand_path("../exa-ai-agent-run-stop", __FILE__), *ARGV[1..]
    when "agent-run-delete"
      exec File.expand_path("../exa-ai-agent-run-delete", __FILE__), *ARGV[1..]
    when "agent-run-events"
      exec File.expand_path("../exa-ai-agent-run-events", __FILE__), *ARGV[1..]
    when "research-start", "research-get", "research-list"
      $stderr.puts "Error: Exa retired the Research API. Use 'exa-ai agent-run-create --query TEXT' instead."
      exit 1
    else
      print_error_for_command(ARGV[0])
      exit 1
    end
  end

  def self.print_help
    puts "Exa CLI v#{Exa::VERSION}"
    puts ""
    puts "Usage: exa-ai <command> [options]"
    puts ""

    print_command_section("Core Search", [
      ["search", "Search the web"],
      ["find-similar", "Find content similar to a URL"],
      ["answer", "Generate an answer to a question"],
      ["context", "Get code context from repositories"],
      ["get-contents", "Retrieve page contents"]
    ])

    print_command_section("Agent Runs", [
      ["agent-run-create", "Create an agent run"],
      ["agent-run-get", "Get agent run details"],
      ["agent-run-list", "List agent runs"],
      ["agent-run-cancel", "Cancel an agent run"],
      ["agent-run-stop", "Stop an agent run early and keep its results"],
      ["agent-run-delete", "Delete an agent run"],
      ["agent-run-events", "Get events for an agent run"]
    ])

    print_command_section("Search Monitors", [
      ["search-monitor-create", "Create a search monitor"],
      ["search-monitor-get", "Get search monitor details"],
      ["search-monitor-list", "List search monitors"],
      ["search-monitor-update", "Update a search monitor"],
      ["search-monitor-delete", "Delete a search monitor"],
      ["search-monitor-trigger", "Run a search monitor now"],
      ["search-monitor-batch", "Delete, pause or unpause search monitors in bulk"],
      ["search-monitor-runs-list", "List search monitor runs"],
      ["search-monitor-runs-get", "Get search monitor run details"]
    ])

    puts "Global Options:"
    puts "  --help, -h         Show this help message"
    puts "  --version          Show version number"
    puts ""
    puts "Examples:"
    puts "  exa-ai search 'ruby programming'"
    puts "  exa-ai context 'React hooks' --tokens-num 5000"
    puts "  exa-ai agent-run-create --query 'Find AI papers'"
  end

  def self.print_command_section(title, commands)
    puts "#{title}:"
    commands.each do |cmd, desc|
      puts "  #{cmd.ljust(24)} #{desc}"
    end
    puts ""
  end

  def self.print_error_for_command(cmd)
    return print_help if cmd.nil?

    $stderr.puts "Error: Unknown command '#{cmd}'"
    $stderr.puts ""

    # Try to suggest similar commands
    suggestion = suggest_command(cmd)
    $stderr.puts "Did you mean: #{suggestion}?" if suggestion

    $stderr.puts ""
    $stderr.puts "Run 'exa-ai --help' for usage information."
  end

  def self.suggest_command(input)
    # Simple suggestion based on string similarity
    # If first char matches and length is similar, suggest it
    input_start = input[0]
    candidates = AVAILABLE_COMMANDS.keys.select { |c| c[0] == input_start }
    candidates.first
  end
end

ExaCLI.run
